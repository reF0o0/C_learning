{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建当前文件",
      "type": "shell",
      "command": "mkdir -p \"${fileDirname}/build\" && cc -g -O0 -Wall -Wextra -std=c17 -pedantic \"${file}\" -o \"${fileDirname}/build/${fileBasenameNoExtension}\"",
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "构建并运行",
      "type": "shell",
      "command": "mkdir -p \"${fileDirname}/build\" && cc -g -O0 -Wall -Wextra -std=c17 -pedantic \"${file}\" -o \"${fileDirname}/build/${fileBasenameNoExtension}\" && \"${fileDirname}/build/${fileBasenameNoExtension}\"",
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
